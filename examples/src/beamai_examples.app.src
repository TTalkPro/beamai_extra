{application, beamai_examples, [
    {description, "BeamAI ChatClient Examples"},
    {vsn, "1.0.0"},
    {registered, []},
    %% jsx / hackney 早已从本项目移除（JSON 走 OTP 27 stdlib json、HTTP 走 gun），
    %% 这里曾经一直列着它们 —— 谁真去 ensure_all_started 这个 app 就会莫名失败。
    {applications, [
        kernel,
        stdlib
    ]},
    {env, []},
    {modules, [
        example_llm_config,
        example_agent,
        example_agent_scenarios,
        test_anthropic_agent,
        test_zhipu_anthropic,
        example_agui_live,
        example_agui_durable,
        %% AG-UI 全能力走查（离线，剧本化 LLM）
        example_agui_scripted,
        example_agui_full,
        %% Open Generative UI 插件（示例：它是前端 runtime 的中间件约定，不是协议）
        example_agui_genui
    ]},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.

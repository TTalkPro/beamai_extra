{erl_opts, [debug_info]}.

{src_dirs, ["src"]}.

%% beamai 依赖路径由 examples/Makefile 单点维护。
%% 请使用：make compile / make test / make shell

%% OTP 27 起 JSON 用 stdlib json；HTTP 后端统一 gun。jsx / hackney 均已不需要。
{deps, [
    {meck, "0.9.2"}
]}.

{dialyzer, [
    {plt_extra_apps, [
        beamai_core, beamai_llm,
        beamai_agent, beamai_tools
    ]}
]}.

{shell, [
    {apps, [beamai]}
]}.

%% OTP 27 起 stdlib 内置 json 模块（beamai 已统一用它，不再依赖 jsx）。
{minimum_otp_vsn, "27"}.

{erl_opts, [
    debug_info,
    warnings,
    warn_unused_vars,
    warn_export_all,
    warn_shadow_vars,
    warn_obsolete_guard,
    warn_unused_import,
    warn_unused_function,
    warn_bif_clash,
    warn_export_vars,
    warn_untyped_record
]}.

%% Umbrella 项目配置
{project_app_dirs, [
    "apps/beamai_tools",
    "apps/beamai_mcp",
    "apps/beamai_a2a",
    "apps/beamai_agui",
    "apps/beamai_rag"
]}.

{deps, [
    %% beamai 核心库 - 通过 git_subdir 从主仓库获取
    %% SimpleAgent (ReAct) 已迁入主仓库，作为依赖引入
    {beamai_core, {git_subdir, "https://github.com/TTalkPro/beamai.git", {tag, "v2.0.0"}, "apps/beamai_core"}},
    {beamai_llm, {git_subdir, "https://github.com/TTalkPro/beamai.git", {tag, "v2.0.0"}, "apps/beamai_llm"}},
    {beamai_agent, {git_subdir, "https://github.com/TTalkPro/beamai.git", {tag, "v2.0.0"}, "apps/beamai_agent"}},
    %% 第三方依赖
    %% 注：HTTP 全线统一到 Gun。hackney 已随上游 beamai_http_hackney 一并摘除。
    {gun, "2.7.0"},
    {cowboy, "2.12.0"},
    {uuid, "2.0.6", {pkg, uuid_erl}}
]}.

{shell, [
    {apps, [
        beamai_core,
        beamai_llm,
        beamai_tools,
        beamai_agent,
        beamai_mcp,
        beamai_a2a,
        beamai_agui,
        beamai_rag
    ]}
]}.

{relx, [
    {release, {beamai_extra, "2.1.1"}, [
        beamai_core,
        beamai_llm,
        beamai_tools,
        beamai_agent,
        beamai_mcp,
        beamai_a2a,
        beamai_agui,
        beamai_rag,
        sasl
    ]},
    {mode, dev},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        {deps, [
            {meck, "1.2.0"}
        ]},
        {erl_opts, [debug_info]}
    ]}
]}.

{project_plugins, [
    {rebar3_proper, "0.12.1"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => "Overview"}}
    ]},
    {main, "README.md"},
    {source_url, "https://github.com/TTalkPro/beamai_extra"},
    {api_reference, true}
]}.

{dialyzer, [
    {plt_extra_apps, [cowboy, gun, public_key]}
]}.

%% beamai_extra 是框架库：大量导出是宿主集成的公共 API，项目内部没有调用者是
%% 预期状态，因此显式排除 exports_not_used，避免公共 API 噪音掩盖真实缺陷。
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{alias, [
    {check, [xref, dialyzer, eunit, ct]}
]}.

{application, beamai_agui, [
    {description, "AG-UI Runtime - agent 事件流服务端（对标 CopilotKit runtime）"},
    {vsn, "1.0.0"},
    {registered, [beamai_agui_sup, beamai_agui_registry,
                  beamai_agui_session_sup, beamai_agui_sessions]},
    {mod, {beamai_agui_app, []}},
    {applications, [
        kernel,
        stdlib,
        beamai_core,
        beamai_agent,
        %% cowboy 是可选依赖（见下方 optional_applications），
        %% 仅在使用 beamai_agui_cowboy_handler 时需要。
        %% 注：optional_applications 的条目必须同时出现在 applications 中，
        %% 否则该声明无效（OTP application 规范）。
        cowboy
    ]},
    {optional_applications, [cowboy]},
    {env, []},
    {modules, [
        %% 应用与监督者
        beamai_agui_app,
        beamai_agui_sup,
        %% Agent 注册表（对标 CopilotRuntime 的 agents 字典）
        beamai_agui_registry,
        %% 会话层：run 的寿命脱离 HTTP 请求（断线重连 / 跨请求 stop）
        beamai_agui_session,
        beamai_agui_session_sup,
        beamai_agui_sessions,
        %% thread 的未决暂停（跨请求 HITL）
        beamai_agui_thread,
        %% 协议
        beamai_agui_types,
        beamai_agui_event,
        %% 翻译层：beamai_agent 回调 → AG-UI 事件序列
        beamai_agui_emitter,
        %% provider 原始流事件 → 增量事件（TOOL_CALL_ARGS / REASONING_*）
        beamai_agui_raw,
        %% state 槽的 JSON Patch 差分（STATE_DELTA）
        beamai_agui_state,
        %% 子 agent lane（SUBAGENT_* + subagentRunId 标签）
        beamai_agui_subagent,
        %% 事件流插件：公共零件 + 两个 activity 类插件
        %% （Open Generative UI 那个在 examples/ —— 它是某个前端 runtime 的
        %%  中间件约定，不是协议，见 example_agui_genui 模块头）
        beamai_agui_plugin,
        beamai_agui_a2ui,
        beamai_agui_mcp_apps,
        %% 一次 run 的编排
        beamai_agui_runner,
        %% HTTP 层（框架无关 + cowboy 适配）
        beamai_agui_http_handler,
        beamai_agui_cowboy_handler
    ]},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
